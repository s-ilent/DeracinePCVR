//
// Copies a single-sample 32-bit image into another bit for bit, whatever their formats mean:
// the depth and colour representations of one guest allocation have the same 32-bit words, and
// this moves them without asking the driver to convert anything. Used only where both sides are
// 32 bits per pixel; everything else keeps the ordinary image copy.

#version 450

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0, r32ui) uniform readonly uimage2D source_image;
layout(set = 0, binding = 1, r32ui) uniform writeonly uimage2D target_image;

layout(push_constant) uniform PushConstants {
    uvec2 extent;
} params;

void main() {
    const ivec2 position = ivec2(gl_GlobalInvocationID.xy);
    if (uint(position.x) >= params.extent.x || uint(position.y) >= params.extent.y) {
        return;
    }
    imageStore(target_image, position, imageLoad(source_image, position));
}