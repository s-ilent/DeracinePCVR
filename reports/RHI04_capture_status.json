        "name": "host-upload registry never populated",
        "location": "shader_param_capture.cpp NoteHostUpload",
        "cause": "declared and implemented but called from nowhere, so g_host_uploads stays empty and FindHostUploadForBinding always fails",
        "effect": "every ordinary binding records GuestMemoryObserved and retains no bytes",
        "repaired": true
      },
      {
        "id": 2,
        "name": "isolated read-constant path retains no bytes",
        "location": "vk_rasterizer.cpp ShouldIsolateReadConstBuffer branch",
        "cause": "sets captured_bytes and captured_hash but never retained_offset or retained_bytes",
        "effect": "616 of 770 bindings are host-verified and unusable by the exporter",
        "repaired": true
      },
      {
        "id": 3,
        "name": "validator resolves descriptors in the wrong domain",
        "location": "draw_package.h ValidatePackage",
        "cause": "image and sampler classes were looked for in package.bindings, but images live in package.textures and samplers in package.samplers",
        "effect": "a package whose images were captured perfectly would be rejected",
        "repaired": true
      },
      {
        "id": 4,
        "name": "readiness accepted a partial binding set",
        "location": "shader_param_capture.cpp shader_buffers_ready",
        "cause": "readiness was !package.bindings.empty(), and a binding with no resource was skipped rather than failing",
        "effect": "one captured binding beside three missing ones read as ready",
        "repaired": true
      }
